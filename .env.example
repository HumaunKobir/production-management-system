APP_NAME="Production Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms
DB_USERNAME=pms
DB_PASSWORD=pms

SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=production

# Session auth: use the exact URL you open in the browser (localhost OR 127.0.0.1, not both).
# On another PC or LAN access, set APP_URL to that machine's address, e.g. http://192.168.1.5:8000
# SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS are optional in local dev (auto-detected).
# VITE_API_URL must stay relative so cookies stay on the same origin:
VITE_API_URL=/api
# Only needed when running `npm run dev` on a different machine than Laravel:
# VITE_BACKEND_URL=http://192.168.1.5:8000
