APP_NAME="Production Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms
DB_USERNAME=pms
DB_PASSWORD=pms

SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=production

# Must match the port where THIS app runs (php artisan serve --port=8001).
# Port 8000 may be used by another project on your machine.
VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_API_URL=/api
